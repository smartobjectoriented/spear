 as="geometry"/></mxCell><mxCell id="c35" value="signals ready-fd; the supervisor then closes both namespace handles" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="254" y="414" width="806" height="28" as="geometry"/></mxCell><mxCell id="c36" value="11" style="fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="34" height="28" as="geometry"/></mxCell><mxCell id="c37" value="supervisor" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="84" y="450" width="160" height="28" as="geometry"/></mxCell><mxCell id="c38" value="RELEASE  os.write(sync_fd, b&quot;x&quot;)  —  the only release primitive" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="254" y="450" width="806" height="28" as="geometry"/></mxCell><mxCell id="c39" value="12" style="fillColor=#f5f5f5;strokeColor=#999999;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="34" height="28" as="geometry"/></mxCell><mxCell id="c40" value="bwrap" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="84" y="486" width="160" height="28" as="geometry"/></mxCell><mxCell id="c41" value="COMMAND finally executes: DNS 10.0.2.3, host loopback blocked" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="254" y="486" width="806" height="28" as="geometry"/></mxCell><mxCell id="c42" value="Why the pin matters — bwrap performs --unshare-user in two steps: it creates a first user namespace to build the sandbox, then a second, nested one to drop privileges. A helper that resolves /proc/&lt;pid&gt;/ns/user even 20 ms later joins the nested namespace and no longer has authority over the netns owner, so setns(CLONE_NEWNET) returns EPERM. Measured: a deliberate 20 ms delay failed 40 runs out of 40 with the PID-based form, and 0 out of 160 with the pinned form. The owning user namespace is derived from the netns object itself, which never changes." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="1020" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="cgroup" id="cgroup"><mxGraphModel background="#ffffff" dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Resource control  —  one transient systemd user scope per command" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="1080" height="30" as="geometry"/></mxCell><mxCell id="c3" value="/sys/fs/cgroup/user.slice/user-&lt;uid&gt;.slice/user@&lt;uid&gt;.service/app.slice/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1000" height="60" as="geometry"/></mxCell><mxCell id="c4" value="delegated controllers:  cpu   memory   pids        (io and cpuset are NOT delegated — they need root)" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="85" width="960" height="22" as="geometry"/></mxCell><mxCell id="c5" value="spear-tool-&lt;uuid&gt;.scope   (INSIDE)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="520" height="260" as="geometry"/></mxCell><mxCell id="c6" value="bwrap" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxG