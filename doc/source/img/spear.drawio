"1" parent="1"><mxGeometry x="840" y="380" width="170" height="62" as="geometry"/></mxCell><mxCell id="c14" value="SPEAR_TEST_NETWORK_RACE=1" style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="460" width="330" height="62" as="geometry"/></mxCell><mxCell id="c15" value="40x repetitions with a deliberate 20/50 ms delay, plus CPU load" style="fillColor=#ffffff;strokeColor=#666666;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="460" width="400" height="62" as="geometry"/></mxCell><mxCell id="c16" value="long running" style="fillColor=#f5f5f5;strokeColor=#999999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="840" y="460" width="170" height="62" as="geometry"/></mxCell><mxCell id="c17" value="Residual-state checks belong to the suites themselves: after every run there must be zero spear-tool-*.scope unit, zero orphan bwrap or slirp4netns process, and no descriptor growth in the supervisor. The characterization test test_characterization_old_pid_based_attachment_still_races deliberately asserts that the OLD attachment still fails — if a future slirp4netns or kernel makes it safe, that test turns red and tells us the workaround can be revisited." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="575" width="1000" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="agent" id="agent"><mxGraphModel background="#ffffff" dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Agent harness — components and their interactions" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="1080" height="30" as="geometry"/></mxCell><mxCell id="c3" value="The spine runs down the left. Everything below the application row is provider-neutral: no module there imports rag_chat." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="34" width="1080" height="18" as="geometry"/></mxCell><mxCell id="c4" value="spear-chat  ·  rag_chat.py&#10;&#10;terminal · confirmation · corpus&#10;registry · slash commands" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="300" height="74" as="geometry"/></mxCell><mxCell id="c5" value="retrieval&#10;&#10;ChromaDB  +  bge-m3 embedder&#10;one collection per corpus" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="385" y="66" width="300" height="74" as="geometry"/></mxCell><mxCell id="c6" value="durable knowledge&#10;&#10;memories-*.md  ·  skills/&#10;rules.d/  ·  system-prompt.md" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="66" width="305" height="74" as="geometry"/></mxCell><mxCell id="c7" value="TaskController&#10;&#10;bounded synchronous lifecycle&#10;for exactly one task" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="300" height="78" as="geometry"/></mxCell><mxCell id="c8" value="PlanningService   (deterministic)&#10;ExplorationService — Explorer&#10;ReviewService — Reviewer&#10;both isolated, read-only, opt-in" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="385" y="172" width="300" height="78" as="geometry"/></mxCell><mxCell id="c9" value="VerificationPolicy&#10;&#10;current-generation evidence only&#10;+ the project&#x27;s own bench" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="172" width="305" height="78" as="geometry"/></mxCell><mxCell id="c10" value="AgentRuntime&#10;&#10;the round loop: model turn,&#10;validation, tool calls, budgets" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="282" width="300" height="88" as="geometry"/></mxCell><mxCell id="c11" value="ModelBackend&#10;&#10;llama.cpp / OpenAI-compatible&#10;Anthropic&#10;local or remote endpoint" style="fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="385" y="282" width="300" height="88" as="geometry"/></mxCell><mxCell id="c12" value="ContextEngine + Compaction&#10;BudgetManager&#10;ProgressMonitor · FailurePolicy&#10;Cancellation" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="282" width="305" height="88" as="geometry"/></mxCell><mxCell id="c13" value="ToolRouter&#10;+ ToolExposurePolicy&#10;&#10;schema · role · hooks · envelope&#10;7 tools; 2 for a read-only role" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="402" width="300" height="88" as="geometry"/></mxCell><mxCell id="c14" value="registered handlers&#10;&#10;bash  ·  edit_file  ·  write_file&#10;append_file  ·  remember&#10;search_corpus  ·  search_internet" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="385" y="402" width="300" height="88" as="geometry"/></mxCell><mxCell id="c15" value="WorkingState&#10;&#10;task truth, event-reduced.&#10;Typed grounded events only —&#10;never the conversation." style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="402" width="305" height="88" as="geometry"/></mxCell><mxCell id="c16" value="CommandPolicy · Workspace&#10;ToolPolicy&#10;&#10;classify → capabilities →&#10;authorize.  Fail-closed." style="fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="522" width="300" height="88" as="geometry"/></mxCell><mxCell id="c17" value="CommandRunner&#10;&#10;Bubblewrap  ·  systemd scope&#10;slirp4netns  ·  prlimit" style="fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="385" y="522" width="300" height="88" as="geometry"/></mxCell><mxCell id="c18" value="ResultStore — full tool output&#10;CheckpointManager — pre-&#10;mutation bytes&#10;AuditLogger — metadata only" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="522" width="305" height="88" as="geometry"/></mxCell><mxCell id="c19" value="Under STATE_DIR  —  what the session accumulates, mounted at /state in the container" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="636" width="1000" height="96" as="geometry"/></mxCell><mxCell id="c20" value="SessionStore&#10;append-only, resumable" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="668" width="300" height="52" as="geometry"/></mxCell><mxCell id="c21" value="audit/runtime-trace.jsonl&#10;spans; never arguments" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="370" y="668" width="300" height="52" as="geometry"/></mxCell><mxCell id="c22" value="trajectories.jsonl&#10;pass · fail · unrated" style="fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="725" y="668" width="305" height="52" as="geometry"/></mxCell><mxCell id="c23" value="objective" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="run" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="bash · mutations" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;dashed=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;dashed=1;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="turns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c32" value="composed context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;dashed=1;" edge="1" parent="1" source="c12" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c34" value="grounded events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="granted capabilities" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c36" value="evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#444444;fontSize=10;dashed=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="Fail-closed, everywhere. A mechanism that cannot be honoured is an error, never a downgrade: no sandbox means the command does not run unsandboxed. Since 2026-08-25 the same rule holds within a turn — a command that reports the sandbox missing makes every later mutation refuse with DENIED rather than edit what nobody can check." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="748" width="490" height="132" as="geometry"/></mxCell><mxCell id="c38" value="Two loops close on evidence rather than on the model&#x27;s claim. Inside the round loop, a mutation carrying no current-generation verification earns one re-prompt. Above it, a failed project bench earns exactly one bounded repair attempt, then re-verification. Whatever is still unverified is prefixed onto the answer, named file by file." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="748" width="490" height="132" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="components" id="components"><mxGraphModel background="#ffffff" dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1380" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SPEAR — every component of the harness" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="8" width="1080" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Dependency direction is strictly downward: nothing below the application band imports rag_chat, and the bottom band imports nothing of the project at all." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=10;" vertex="1" parent="1"><mxGeometry x="0" y="34" width="1080" height="18" as="geometry"/></mxCell><mxCell id="c4" value="Application  —  the only layer that talks to a human" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="60" width="1010" height="148" as="geometry"/></mxCell><mxCell id="c5" value="spear-chat.sh&#10;REPL launcher, backend flags" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="55" y="92" width="233" height="52" as="geometry"/></mxCell><mxCell id="c6" value="docker/spear-docker.sh&#10;container, /state, /corpora" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="300" y="92" width="233" height="52" as="geometry"/></mxCell><mxCell id="c7" value="backend_select.py — 222 l.&#10;startup backend picker" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="545" y="92" width="233" height="52" as="geometry"/></mxCell><mxCell id="c8" value="rag_chat.py — 8 044 l.&#10;session · corpora · UI · handlers" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="790" y="92" width="233" height="52" as="geometry"/></mxCell><mxCell id="c9" value="index_corpus.py — 445 l.&#10;curated build-system walk" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="55" y="150" width="233" height="52" as="geometry"/></mxCell><mxCell id="c10" value="index_dir.py — 262 l.&#10;generic tree indexer" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="300" y="150" width="233" height="52" as="geometry"/></mxCell><mxCell id="c11" value="embedding.py — 624 l.&#10;bge-m3, one definition" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="545" y="150" width="233" height="52" as="geometry"/></mxCell><mxCell id="c12" value="memory_store.py — 382 l.&#10;memories-*.md + sidecar" style="fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="790" y="150" width="233" height="52" as="geometry"/></mxCell><mxCell id="c13" value="Orchestration  —  one task, bounded and synchronous" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;verticalAlign=top;fontStyle=1;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="224" width="1010" height="148" as="geometry"/></mxCell><mxCell id="c14" value="task_controller.py — 858 l.&#10;lifecycle, gates, warnings" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="55" y="256" width="233" height="52" as="geometry"/></mxCell><mxCell id="c15" value="planning.py — 338 l.&#10;deterministic plan steps" style="fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="300" y="256" width="233" height="52" as="geometry"/></mxCell><mxCell id="c16" value="orchestration.py — 778 l.&#10;Explorer delegation (opt-in)" style="fillColor=#d5e8d4;strokeColor=#82b3