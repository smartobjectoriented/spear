# Claude Code on top of a SPEAR image: one more layer, so the image that
# carries the corpora, their index, the rules and the skills also carries the
# assistant that reads them.
#
#     scripts/docker/add-claude.sh IMAGE [TAG]
#
# SPEAR itself stays the image's entrypoint; spear-claude is the other one.

ARG BASE
FROM ${BASE}

USER root

# Installed under a home of its own and made readable by all: the container
# runs as whoever launches it. It never updates itself, an image is rebuilt.

ENV DISABLE_AUTOUPDATER=1

RUN HOME=/opt/claude bash -c 'curl -fsSL https://claude.ai/install.sh | bash' \
    && ln -sf /opt/claude/.local/bin/claude /usr/local/bin/claude \
    && chmod -R a+rX /opt/claude \
    && claude --version

# The exporter comes along, so an image built before it existed serves too.

COPY --from=repo client/cli/claude_export.py /opt/spear/client/cli/claude_export.py
COPY spear-claude spear-claude-export /usr/local/bin/
RUN chmod 755 /usr/local/bin/spear-claude /usr/local/bin/spear-claude-export
