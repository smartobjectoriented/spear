#!/bin/bash
# Claude Code on this image's corpora, installed as `claude`: prepared for the
# corpus the current directory is in (spear-claude-setup), then started.
#
# What a SPEAR request gets by itself -- the passages retrieved from the index
# and the workspace's recorded knowledge -- reaches each prompt through a hook
# the image declares for every client (/etc/claude-code/managed-settings.json).

set -e

spear-claude-setup

exec /opt/claude/.local/bin/claude "$@"
