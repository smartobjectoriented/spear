#!/bin/bash
# Run a published SPEAR image with nothing but docker: no checkout of this
# repository, no registry of your own. It serves any image whose corpora are
# baked.
#
#     cd <your tree> && spear
#
# opens a shell in the container, in that tree, bound at the place the image
# knows it by when it is a checkout of one of its corpora (same path under
# your home as under /corpora) and at its own path otherwise. Two commands
# are there: `spear-chat` for SPEAR, `claude` for Claude Code, each with the
# rules, skills and index of the corpus.
#
#     spear [--image IMAGE] [--pull]
#           [--reds USER@HOST [--key FILE] [--port N] | --endpoint URL
#            | --provider anthropic [--model NAME]]
#           [--tree NAME | --corpus PATH]
#           [--mount HOST_DIR:PATH]... [--state DIR] [--build TAG]
#           [-- harness args, e.g. --ask, --auto, --fresh]
#
#   --image     the image to run; default ghcr.io/smartobjectoriented/spear-reds
#               at this release
#   --pull      docker pull it first
#   --reds      the inference host SPEAR talks to, as ssh names it; a tunnel
#               is opened from this machine to its port (--port, default 8010)
#               unless one is already up. --key names the ssh identity when
#               the host needs one named.
#   --endpoint  any OpenAI-compatible URL instead of the tunnel
#   --provider  a hosted model instead of an endpoint: anthropic, with --model
#               naming the model. Its key is ANTHROPIC_API_KEY.
#   --tree      the current directory is your checkout of the image's corpus
#               NAME, wherever it is on this machine
#   --corpus    work in the image's own copy of a tree, named by its path
#               under /corpora (e.g. opencn/opencn-ng); nothing of this
#               machine is bound. --list prints them.
#   --mount     bind another checkout over a baked tree: HOST_DIR:PATH, with
#               PATH the tree's path under /corpora. Repeatable.
#   --state     where conversations, knowledge, audit and the logins land on
#               this machine (default ~/.spear/state)
#   --list      print the image's corpora and exit
#   --build     make a new image, TAG, out of the image and your state: the
#               corpora you registered, their index and the knowledge you
#               recorded become part of it, without the source trees. Someone
#               who runs TAG from a checkout of the same tree picks the work
#               up where it is.
#   --install   copy this script to ~/.local/bin and, when there is none yet,
#               write the configuration file with the image named by --image;
#               nothing is run
#
# With harness args, SPEAR starts at once instead of the shell, and a model
# has to be named. In the shell a model is needed by spear-chat only: Claude
# Code logs in with your own account, once.
#
# What does not change from one run to the next goes in a configuration file,
# read before the options: client/local.conf of the repository this script is
# in, else ~/.config/spear/local.conf. It is shell, one assignment per line:
#
#     SPEAR_IMAGE=registry.example/spear:1.0-acme
#     SPEAR_PROVIDER=anthropic
#     SPEAR_MODEL=<model name>
#     ANTHROPIC_API_KEY=<key>
#
# or REDS_HOST and SPEAR_REDS_KEY for an inference host. An option overrides
# the file.
#
# spear-docker.sh is the other launcher: for a workstation that has the
# repository and mounts its own registered trees. This one is for everyone else.
set -e

# The image this script was published with. From the repository the release
# script answers; from a copy of this file alone, the constant does.
HERE="$(cd "$(dirname "$0")" && pwd)"

for conf in "$HERE/../../client/local.conf" "${XDG_CONFIG_HOME:-$HOME/.config}/spear/local.conf"; do
    if [ -r "$conf" ]; then
        # shellcheck disable=SC1090
        . "$conf"
        break
    fi
done

VERSION="$("$HERE/../spearversion.sh" 2>/dev/null || echo 0.3.0)"
IMAGE="${SPEAR_IMAGE:-ghcr.io/smartobjectoriented/spear-reds:$VERSION-reds}"
REDS_HOST="${REDS_HOST:-}"
REDS_KEY="${SPEAR_REDS_KEY:-}"
REDS_PORT="${REDS_PORT:-8010}"
LPORT="${SPEAR_TUNNEL_PORT:-8082}"
ENDPOINT="${SPEAR_API_BASE:-}"
MODEL_NAME="${SPEAR_MODEL_NAME:-qwen3}"
PROVIDER="${SPEAR_PROVIDER:-}"
MODEL="${SPEAR_MODEL:-}"
STATE="${SPEAR_STATE_DIR:-$HOME/.spear/state}"
CORPUS=""
TREE=""
PULL=0
LIST=0
INSTALL=0
BUILD=""
MOUNTS=()
ARGS=()

usage() { sed -n '2,67p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
die() { echo "spear: $*" >&2; exit 1; }

while [ $# -gt 0 ]; do
    case "$1" in
        --image)    IMAGE="$2"; shift 2 ;;
        --pull)     PULL=1; shift ;;
        --reds)     REDS_HOST="$2"; PROVIDER=""; shift 2 ;;
        --key)      REDS_KEY="$2"; shift 2 ;;
        --port)     REDS_PORT="$2"; shift 2 ;;
        --endpoint) ENDPOINT="$2"; PROVIDER=""; shift 2 ;;
        --provider) PROVIDER="$2"; shift 2 ;;
        --model)    MODEL="$2"; shift 2 ;;
        --tree)     TREE="$2"; shift 2 ;;
        --corpus)   CORPUS="$2"; shift 2 ;;
        --mount)    MOUNTS+=("$2"); shift 2 ;;
        --state)    STATE="$2"; shift 2 ;;
        --list)     LIST=1; shift ;;
        --install)  INSTALL=1; shift ;;
        --build)    BUILD="$2"; shift 2 ;;
        -h|--help)  usage ;;
        --)         shift; ARGS=("$@"); break ;;
        *)          ARGS+=("$1"); shift ;;
    esac
done

if [ "$INSTALL" = 1 ]; then
    BIN="$HOME/.local/bin"
    CONF="${XDG_CONFIG_HOME:-$HOME/.config}/spear/local.conf"
    mkdir -p "$BIN" "$(dirname "$CONF")"

    # A link to this very file is already the install; anything else is
    # replaced, a link first so that the copy does not go through it.

    if [ "$(readlink -f "$BIN/spear")" != "$(readlink -f "$0")" ]; then
        rm -f "$BIN/spear"
        cp "$0" "$BIN/spear"
        chmod 755 "$BIN/spear"
    fi

    # The launcher's former name would otherwise stay beside the new one.

    rm -f "$BIN/spear-run.sh"

    echo "installed $BIN/spear"

    if [ -e "$CONF" ]; then
        echo "kept      $CONF"
    else
        cat > "$CONF" <<EOF
# Read by spear before its options; shell, one assignment per line.
SPEAR_IMAGE=$IMAGE

# The model spear-chat talks to: a hosted one,
#SPEAR_PROVIDER=anthropic
#SPEAR_MODEL=<model name>
#ANTHROPIC_API_KEY=<key>
# or an inference host reached through ssh.
#REDS_HOST=<account>@<host>
#SPEAR_REDS_KEY=<ssh identity file>
EOF
        echo "wrote     $CONF"
    fi

    case ":$PATH:" in
        *":$BIN:"*) ;;
        *) echo "$BIN is not on your PATH: add it in your shell's startup file" >&2 ;;
    esac

    exit 0
fi

command -v docker >/dev/null || die "docker is not installed"
[ "$PULL" = 1 ] && docker pull "$IMAGE"
docker image inspect "$IMAGE" >/dev/null 2>&1 || die "no image $IMAGE here; add --pull, or docker login first"

if [ -n "$BUILD" ]; then
    [ -d "$STATE" ] || die "no state at $STATE: nothing to add to $IMAGE"
    NAME="spear-build-$$"

    # As root, since the registry and the index of an image are not the
    # user's; the state is only read.

    docker run --name "$NAME" --user 0 -v "$STATE:/state:ro" \
        --entrypoint spear-bake-state "$IMAGE" /state "$HOME" \
        || { docker rm -f "$NAME" >/dev/null 2>&1; die "the image could not take the state"; }

    # The container was started on another program than the image's own.

    docker commit --change 'ENTRYPOINT ["/opt/spear/entrypoint.sh"]' --change 'CMD []' \
        --change 'USER root' "$NAME" "$BUILD" >/dev/null
    docker rm "$NAME" >/dev/null
    echo "built $BUILD"
    exit 0
fi

# The image's corpora: a name and a path under /corpora on each line.
REGISTRY="$(docker run --rm --entrypoint /opt/spear/client/bin/python "$IMAGE" -c '
import json
for name, spec in sorted(json.load(open("/opt/spear/client/projects.json")).items()):
    print(name, spec["path"])')"

if [ "$LIST" = 1 ]; then
    while read -r name rel; do
        [ -n "$name" ] && printf '%-18s /corpora/%s\n' "$name" "$rel"
    done <<< "$REGISTRY"
    exit 0
fi

# The model SPEAR talks to. The tunnel stays on this machine: the image
# carries no key, and with host networking 127.0.0.1 is the same thing on
# both sides. On failure WHY says what is missing.
BACKEND=()
WHY=""

backend() {
    if [ -n "$PROVIDER" ]; then
        [ "$PROVIDER" = anthropic ] || die "--provider knows anthropic, not '$PROVIDER'"

        if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
            WHY="--provider anthropic needs ANTHROPIC_API_KEY; set it in the configuration file (see --help)"
            return 1
        fi

        export ANTHROPIC_API_KEY

        # The name alone: the value reaches the container from this
        # environment and never appears in a process list.

        BACKEND=(-e ANTHROPIC_API_KEY -e "SPEAR_CHAT_PROVIDER=anthropic" -e "SPEAR_CHAT_MODEL=$MODEL")
        return 0
    fi

    if [ -z "$ENDPOINT" ]; then
        if [ -z "$REDS_HOST" ]; then
            WHY="name the model: --reds USER@HOST, --endpoint URL or --provider anthropic"
            return 1
        fi

        ENDPOINT="http://127.0.0.1:$LPORT/v1"

        if ! curl -sf -m 3 "$ENDPOINT/models" >/dev/null 2>&1; then
            SSH_OPTS=(-o ConnectTimeout=12 -o ExitOnForwardFailure=yes -o ServerAliveInterval=30)

            # A host with a low MaxAuthTries disconnects ssh before it reaches
            # the right key unless that key is the only one offered.

            [ -n "$REDS_KEY" ] && SSH_OPTS+=(-o IdentitiesOnly=yes -i "$REDS_KEY")
            echo "opening the tunnel :$LPORT -> $REDS_HOST:$REDS_PORT" >&2

            # A tunnel that died with the VPN keeps its port, and a new one
            # then fails to bind: say that, not "is the host reachable?".

            if (exec 3<>"/dev/tcp/127.0.0.1/$LPORT") 2>/dev/null; then
                held=$(ss -ltnpH "sport = :$LPORT" 2>/dev/null | grep -o 'pid=[0-9]*' | head -1)
                WHY="port $LPORT is held by a tunnel that no longer answers${held:+ ($held)}: end it and run spear again"
                return 1
            fi

            if ! ssh "${SSH_OPTS[@]}" -L "$LPORT:localhost:$REDS_PORT" -N -f "$REDS_HOST"; then
                WHY="tunnel failed: is $REDS_HOST reachable (VPN?) and your key authorised?"
                return 1
            fi
        fi

        if ! curl -sf -m 5 "$ENDPOINT/models" >/dev/null 2>&1; then
            WHY="the tunnel is up but nothing answers on $REDS_HOST:$REDS_PORT"
            return 1
        fi
    fi

    BACKEND=(-e "SPEAR_API_BASE=$ENDPOINT" -e "SPEAR_MODEL_NAME=$MODEL_NAME")
}

# A shell needs no model to open; a session started at once does.
ENTRY=()

if [ ${#ARGS[@]} -eq 0 ]; then
    ENTRY=(--entrypoint spear-shell)
    backend || echo "spear: no model for spear-chat ($WHY)" >&2
else
    backend || die "$WHY"
    [ -n "$PROVIDER" ] && ARGS=(--provider "$PROVIDER" ${MODEL:+--model "$MODEL"} "${ARGS[@]}")
fi

# Your own checkouts over the baked trees, at the baked paths.
BINDS=()
for spec in "${MOUNTS[@]}"; do
    host="${spec%%:*}"; rel="${spec#*:}"
    [ "$host" != "$spec" ] && [ -d "$host" ] || die "--mount wants HOST_DIR:PATH with an existing HOST_DIR, not '$spec'"
    BINDS+=(-v "$(readlink -f "$host"):/corpora/${rel#/corpora/}")
done

# Where the work happens: the image's copy when one is named, else this
# directory -- over the baked tree it is a checkout of, or at its own path.
if [ -n "$CORPUS" ]; then
    WORKDIR="/corpora/${CORPUS#/corpora/}"
elif [ -n "$TREE" ]; then
    rel=""

    while read -r name path; do
        if [ "$name" = "$TREE" ]; then rel="$path"; fi
    done <<< "$REGISTRY"

    [ -n "$rel" ] || die "the image has no corpus named '$TREE' (--list names them)"
    BINDS+=(-v "$PWD:/corpora/$rel")
    WORKDIR="/corpora/$rel"
else
    BINDS+=(-v "$PWD:$PWD")
    WORKDIR="$PWD"

    while read -r name rel; do
        [ -n "$rel" ] || continue

        case "$PWD/" in
            "$HOME/$rel/"*)
                BINDS[${#BINDS[@]}-1]="$HOME/$rel:/corpora/$rel"
                WORKDIR="/corpora/$rel${PWD#"$HOME/$rel"}"
                break ;;
        esac
    done <<< "$REGISTRY"
fi

mkdir -p "$STATE/home"
TTY=(-i); [ -t 0 ] && TTY=(-i -t)

# A name that says what the container is, for whoever attaches an editor to it.

NAME="spear-$(printf '%s' "${WORKDIR##*/}" | tr -c 'A-Za-z0-9_.-' '-')-$$"

# The harness bounds what each command may take, and refuses to run one when
# nothing does. A container has no systemd to do it per command, so Docker
# bounds the container and the harness is told so: the limits and the variable
# go together. They hold your own builds too, hence most of the machine;
# SPEAR_CONTAINER_MEMORY in the configuration file names another bound.

MEMORY="${SPEAR_CONTAINER_MEMORY:-$(awk '/^MemTotal:/ { printf "%dm", $2 * 3 / 4 / 1024 }' /proc/meminfo)}"

# chromadb opens the image's index read-write, and overlayfs then copies the
# whole database into each new container: some 25 GB and tens of seconds at
# every start, long enough for chromadb to give up waiting. A named volume
# holds it instead, filled from the image once and reused while its content
# stays the same -- the content image the code was laid on (spear.content),
# so a new harness alone keeps the volume; volumes of earlier images are
# removed when not in use.

INDEX=()
SHIPPED="$(docker image inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$IMAGE" 2>/dev/null \
    | sed -n 's/^SPEAR_SHIPPED_DB_PATH=//p')"

if [ -n "$SHIPPED" ]; then
    CONTENT="$(docker image inspect -f '{{ index .Config.Labels "spear.content" }}' "$IMAGE")"
    [ -n "$CONTENT" ] || CONTENT="$(docker image inspect -f '{{.Id}}' "$IMAGE")"
    VOLUME="spear-index-$(printf '%s' "$CONTENT" | cut -d: -f2 | cut -c1-12)"

    for old in $(docker volume ls -q --filter name=spear-index-); do
        [ "$old" = "$VOLUME" ] || docker volume rm "$old" >/dev/null 2>&1 || true
    done

    docker volume inspect "$VOLUME" >/dev/null 2>&1 \
        || echo "spear: copying the image's index into the volume $VOLUME, once" >&2
    INDEX=(-v "$VOLUME:$SHIPPED")
fi

# The three --security-opt are what bubblewrap, the harness's sandbox, needs
# to start inside a container; without them it refuses every command.

exec docker run --rm --name "$NAME" "${TTY[@]}" \
    --security-opt seccomp=unconfined \
    --security-opt apparmor=unconfined \
    --security-opt systempaths=unconfined \
    --memory "$MEMORY" --memory-swap "$MEMORY" --pids-limit 4096 \
    -e SPEAR_RESOURCE_CONTROL=delegated \
    --network host \
    --user "$(id -u):$(id -g)" \
    "${BACKEND[@]}" \
    -e "SPEAR_STATE_DIR=/state" \
    -e "HOME=/state/home" \
    -v "$STATE:/state" \
    "${INDEX[@]}" \
    "${BINDS[@]}" \
    -w "$WORKDIR" \
    "${ENTRY[@]}" \
    "$IMAGE" "${ARGS[@]}"
