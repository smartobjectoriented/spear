#!/bin/bash
# Manage SPEAR container images: one entry point over scripts/docker/.
#
#     spear-image build   <harness|base|project> ...        (tiered, see build-tiered.sh)
#     spear-image build   <public|reds|private> [--bake a,b,...] [--knowledge a,b,...|all]
#                         [--tag TAG]                         (legacy flat profiles)
#     spear-image get     <base|project>                     (pull from the registry, else load the shared tarball)
#     spear-image update  <base|project>                     (rebuild from local.conf, refresh the tarball, try to push)
#     spear-image list
#     spear-image inspect <public|reds|private|TAG>
#     spear-image run     <public|reds|private|TAG> [spear-docker options] [-- harness args]
#     spear-image save    <public|reds|private|TAG> [FILE]
#     spear-image load    FILE
#     spear-image push    <public|reds|private|TAG> [--allow-push]
#     spear-image erase   <public|reds|private|all|TAG> [--cache]
#
# A profile names the image scripts/docker/build.sh tags by default,
# spear:<version>-<profile>, the version being scripts/spearversion.sh's.
# Anything with a ':' is taken as a tag as it is.
#
# The scripts underneath keep their own rules -- build.sh decides what a
# profile may carry, push.sh refuses a private image without
# --allow-push -- and this one only saves remembering their options. It
# decides nothing they would not.
set -e

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# The release this is: "[spear vX.Y.Z] <script> <args>" on stderr, once.
[ -r "$HERE/common/banner.sh" ] && . "$HERE/common/banner.sh"
DOCKER_SCRIPTS="$HERE/docker"
VERSION="$("$HERE/spearversion.sh")"
LABEL=ch.heig-vd.reds.spear

# This machine's configuration (untracked): the image-tier choices that used to
# be flags and the entity registries push reads. local.conf, or the legacy
# machine.env. Sourced once here, every action and the scripts it execs inherit
# it; build-tiered.sh re-reads it so a direct call still works.
CLIENT="$HERE/../client"
if [ -r "$CLIENT/local.conf" ]; then . "$CLIENT/local.conf"
elif [ -r "$CLIENT/machine.env" ]; then . "$CLIENT/machine.env"; fi

usage() {
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

die() { echo "spear-image: $*" >&2; exit 1; }

# profile or tag -> tag
image_of() {
    case "$1" in
        "") die "name an image: harness, base, project, public, reds, private or a tag" ;;
        harness|base|project|public|reds|private) echo "spear:$VERSION-$1" ;;
        *:*) echo "$1" ;;
        *) die "'$1' is neither a profile (harness, base, project, public, reds, private) nor a tag" ;;
    esac
}

exists() { docker image inspect "$1" >/dev/null 2>&1; }

# Where images travel when a registry cannot or will not take them: a directory
# of tarballs a colleague can reach (SPEAR_SHARE_DIR, default the SPEAR tree's
# parent), each named spear-<tier>-<version>.tar.zst.
SHARE_DIR="${SPEAR_SHARE_DIR:-$(cd "$HERE/../.." && pwd)}"

# The archive of a tier is dominated by an embedding index, which barely
# compresses: a high level costs many minutes of CPU for almost no size.

ZSTD_LEVEL="${SPEAR_ZSTD_LEVEL:-3}"

# The registry repository to pull from and push to -- the full path, no tag
# (e.g. reds-gitlab.heig-vd.ch:5050/reds-general/spear/spear). Left unset, get
# goes straight to the tarball and update does not push.
REGISTRY_IMAGE="${SPEAR_REGISTRY_IMAGE:-}"

tarball_of() { printf '%s/spear-%s-%s.tar.zst' "$SHARE_DIR" "$1" "$VERSION"; }

# Labels moved to the neutral `spear.` namespace (build-tiered.sh); read it
# first, falling back to the old one so images built before the rename still
# show their profile.

label() {
    local v
    v="$(docker image inspect "$1" \
        --format "{{ index .Config.Labels \"spear.$2\" }}" 2>/dev/null)"
    [ -n "$v" ] && { printf '%s' "$v"; return; }
    docker image inspect "$1" \
        --format "{{ index .Config.Labels \"$LABEL.$2\" }}" 2>/dev/null
}

[ $# -gt 0 ] || usage 1
action="$1"; shift

case "$action" in
    -h|--help|help)
        usage ;;

    build)
        profile="$1"
        case "$profile" in
            harness|code|base|project)
                shift
                exec "$DOCKER_SCRIPTS/build-tiered.sh" "$profile" "$@" ;;
            public|reds|private) shift ;;
            *) die "build needs a profile: harness, base, project (tiered) or public, reds, private (legacy)" ;;
        esac

        tag="" bake=() knowledge=()

        while [ $# -gt 0 ]; do
            case "$1" in
                --tag) tag="$2"; shift 2 ;;
                --bake) bake=(--bake "$2"); shift 2 ;;
                --knowledge) knowledge=(--knowledge "$2"); shift 2 ;;
                *) die "build: unknown option $1" ;;
            esac
        done

        exec "$DOCKER_SCRIPTS/build.sh" ${tag:+"$tag"} --profile "$profile" "${bake[@]}" \
            "${knowledge[@]}" ;;

    get)
        # Obtain a tier's image without having to know where it lives: the
        # registry if one is set and reachable, otherwise the shared tarball.
        tier="$1"
        case "$tier" in
            harness|base|project) ;;
            "") die "get needs a tier: base or project" ;;
            *)  die "get takes a tier (base or project), not '$tier'" ;;
        esac
        tag="spear:$VERSION-$tier"

        if exists "$tag"; then echo "already present: $tag"; exit 0; fi

        if [ -n "$REGISTRY_IMAGE" ]; then
            ref="$REGISTRY_IMAGE:$VERSION-$tier"
            echo "pulling $ref ..."
            if docker pull "$ref"; then
                docker tag "$ref" "$tag"
                echo "got $tag (from $ref)"; exit 0
            fi
            echo "registry pull failed; trying the shared tarball" >&2
        fi

        tb="$(tarball_of "$tier")"
        if [ -f "$tb" ]; then
            echo "loading $tb ..."
            zstd -dc "$tb" | docker load
            exit 0
        fi

        die "cannot get $tag: no registry hit and no tarball at $tb.
Set SPEAR_REGISTRY_IMAGE or SPEAR_SHARE_DIR in client/local.conf, or put the tarball there." ;;

    update)
        # Rebuild a tier from this host's current state (local.conf drives the
        # contents -- no flags), then refresh the shared tarball and, if a
        # registry is set, try to push. Indexing stays a separate, explicit step.
        tier="$1"
        case "$tier" in
            base|project) ;;
            "") die "update needs a tier: base or project" ;;
            *)  die "update takes base or project, not '$tier'" ;;
        esac
        tag="spear:$VERSION-$tier"

        case "$tier" in
            base)
                harness="spear:$VERSION-harness"
                exists "$harness" || "$DOCKER_SCRIPTS/build-tiered.sh" harness
                "$DOCKER_SCRIPTS/build-tiered.sh" base ;;
            project)
                exists "spear:$VERSION-base" \
                    || die "no base image yet -- run 'spear-image get base' or 'spear-image update base' first"
                "$DOCKER_SCRIPTS/build-tiered.sh" project ;;
        esac

        command -v zstd >/dev/null || die "zstd is not installed"
        tb="$(tarball_of "$tier")"
        mkdir -p "$SHARE_DIR"
        echo "refreshing $tb ..."
        docker save "$tag" | zstd -T0 "-$ZSTD_LEVEL" -f -o "$tb"
        [ "$(label "$tag" redistributable)" = false ] && echo \
            "!! $tb carries licensed and customer material: not redistributable" >&2

        if [ -n "$REGISTRY_IMAGE" ]; then
            ref="$REGISTRY_IMAGE:$VERSION-$tier"
            docker tag "$tag" "$ref"
            echo "pushing $ref ..."
            if "$DOCKER_SCRIPTS/push.sh" "$ref"; then
                echo "pushed $ref"
            else
                echo "registry push failed -- the tarball at $tb is the usable copy" >&2
            fi
        fi

        echo "updated $tag" ;;

    list)
        # The label, not the repository name: an image retagged for a registry
        # is still one of ours, and says which profile it is. Both namespaces:
        # the tiered images carry spear.profile, the legacy ones the old one.
        { docker images --filter "label=spear.profile" \
              --format '{{.Repository}}:{{.Tag}}\t{{.ID}}\t{{.Size}}\t{{.CreatedSince}}'
          docker images --filter "label=$LABEL.profile" \
              --format '{{.Repository}}:{{.Tag}}\t{{.ID}}\t{{.Size}}\t{{.CreatedSince}}'
        } | sort -u |
        while IFS=$'\t' read -r name id size created; do
            printf '%-40s %-11s %-9s redistributable=%-5s %s\n' "$name" \
                "$(label "$id" profile)" "$size" "$(label "$id" redistributable)" \
                "$created"
        done ;;

    inspect)
        image="$(image_of "$1")"
        exists "$image" || die "no such image: $image"
        printf 'image            %s\n' "$image"
        printf 'profile          %s\n' "$(label "$image" profile)"
        printf 'redistributable  %s\n' "$(label "$image" redistributable)"
        printf 'built            %s\n' "$(label "$image" built)"
        printf 'size             %s\n' "$(docker image inspect "$image" \
            --format '{{.Size}}' | numfmt --to=iec)" ;;

    run)
        image="$(image_of "$1")"; shift
        exists "$image" || die "no such image: $image (spear-image build first)"
        SPEAR_IMAGE="$image" exec "$DOCKER_SCRIPTS/spear-docker.sh" "$@" ;;

    save)
        image="$(image_of "$1")"
        exists "$image" || die "no such image: $image"
        out="${2:-spear-$(label "$image" profile).tar.zst}"
        [ -e "$out" ] && die "$out exists; name another file or remove it"
        command -v zstd >/dev/null || die "zstd is not installed"
        echo "saving $image -> $out"
        docker save "$image" | zstd -T0 "-$ZSTD_LEVEL" -o "$out"

        [ "$(label "$image" redistributable)" = false ] && echo \
            "!! $out carries licensed and customer material: not redistributable" >&2
        exit 0 ;;

    load)
        [ -f "$1" ] || die "load needs a file saved by 'spear-image save'"
        zstd -dc "$1" | docker load ;;

    push)
        image="$(image_of "$1")"; shift
        exec "$DOCKER_SCRIPTS/push.sh" "$@" "$image" ;;

    erase)
        target="$1"; shift || true
        cache=0

        while [ $# -gt 0 ]; do
            case "$1" in
                --cache) cache=1; shift ;;
                *) die "erase: unknown option $1" ;;
            esac
        done

        if [ "$target" = all ]; then
            mapfile -t images < <(docker images -q --filter "label=$LABEL.profile" | sort -u)
        else
            image="$(image_of "$target")"
            exists "$image" || die "no such image: $image"
            images=("$image")
        fi

        if [ "${#images[@]}" -eq 0 ]; then
            echo "no SPEAR image to erase"
        else
            # -f: a registry retag of the same image would otherwise block it.
            docker rmi -f "${images[@]}"
        fi

        # The build cache keeps every layer an image was made of -- for an
        # private image, the licensed documents and customer trees it
        # copied. Removing the image does not remove those.
        if [ "$cache" = 1 ]; then
            docker builder prune -f
        else
            echo "(build cache kept; --cache also removes the layers it holds)"
        fi ;;

    *)
        echo "spear-image: unknown action '$action'" >&2
        usage 1 ;;
esac
