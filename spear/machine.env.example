# The shape of spear/machine.env, this machine's local configuration.
# Do not copy it by hand: `spear-configure` (after `. ./env.sh` at the
# repository root) writes machine.env from what the machine has, and
# `spear-configure --check` says whether an existing one still matches.

# Where sessions accumulate: history, memories, audit, the standard store.
export SPEAR_STATE_DIR="$HOME/.local/state/spear"

# The deployment's own content, from a private tree beside the checkout.
export SPEAR_RULES_DIR=/path/to/spear-private/rules.d
export SPEAR_SKILLS_DIR=/path/to/spear-private/skills
export SPEAR_BENCH_DIR=/path/to/spear-private/benches
[ -r /path/to/spear-private/engagement.env ] && . /path/to/spear-private/engagement.env

# Document embedding for normative standards, on the GPU host, pinned to the
# revision both ends' Hub caches resolve `main` to.
export SPEAR_STANDARD_EMBED_MODEL=BAAI/bge-m3
export SPEAR_STANDARD_EMBED_REVISION=<40-hex revision>
export SPEAR_STANDARD_EMBED_REMOTE=user@gpu-host

# Retrieval mode and structural completion are set per document
# (/standard retrieval), not here: exported, they would override every
# document for every session.

# --- local additions: kept as they are by spear-configure ---
